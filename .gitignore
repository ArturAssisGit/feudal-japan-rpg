# Builds and crash reports
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Third-party assets (licensed, not redistributable) - keep them out of the public repo
/[Aa]ssets/Adventure Nature*/
/[Aa]ssets/AssetStoreOriginals/
